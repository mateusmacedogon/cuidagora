# ==============================================================================
# CuidAgora — Variáveis de Ambiente para Deploy (Vercel / Local)
# ==============================================================================

# 1. Banco de Dados PostgreSQL (Vercel Postgres, Neon, Supabase, etc.)
# Se NÃO informado, a aplicação roda no modo demonstração em memória com dados pré-populados.
# Formato padrão: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgres://default:default@ep-cool-cloud.us-east-1.aws.neon.tech/neondb?sslmode=require"

# A Vercel Postgres e o Neon também injetam automaticamente POSTGRES_URL:
POSTGRES_URL="postgres://default:default@ep-cool-cloud.us-east-1.aws.neon.tech/neondb?sslmode=require"
POSTGRES_PRISMA_URL="postgres://default:default@ep-cool-cloud.us-east-1.aws.neon.tech/neondb?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://default:default@ep-cool-cloud.us-east-1.aws.neon.tech/neondb?sslmode=require"

# 2. Ambiente de Execução
NODE_ENV="production"
